<file path="scripts/ddns-admin.sh">
#!/usr/bin/env bash
set -euo pipefail

BINDING="KV"

# Auto-discover KV Namespace ID (<worker-name>-kv)
KV_ID=$(npx wrangler kv namespace list 2>/dev/null | jq -r '.[] | select(.title | ascii_downcase | endswith("-kv")) | .id' | head -n 1 || true)

if [[ -n "$KV_ID" ]]; then
  TARGET_ARGS=(--namespace-id="$KV_ID" --remote)
else
  TARGET_ARGS=(--binding="$BINDING" --remote)
fi

usage() {
  cat <<EOF
Usage: $(basename "$0") <command> [arguments]

Commands:
  seed-config [config.json]             Load config.json into KV (config:settings & zone:map)
  invite <username> [ttl_hours]         Generate an 8-digit PIN invite (default: 24h)
  allow-exact <username> <fqdn>         Authorize an exact hostname (e.g., kb.example.com)
  allow-suffix <username> <suffix>      Authorize a domain suffix (e.g., .vpn.example.net)
  revoke-host <username> <host_or_suf>  Remove a hostname or suffix from a user
  show-user <username>                  Display a user's current KV record
  list-users                            List all registered users
  list-invites                          List all active pending invites
  audit [limit]                         Fetch and format recent audit logs (default: 10)
EOF
  exit 1
}

[[ $# -lt 1 ]] && usage
CMD="$1"
shift

case "$CMD" in
  seed-config)
    FILE="${1:-config.json}"
    [[ -f "$FILE" ]] || { echo "Error: Config file '$FILE' not found." >&2; exit 1; }
    # Strip _comment_* keys and zone_map object before writing config:settings
    SETTINGS_JSON=$(jq -c 'with_entries(select(.key | startswith("_comment") | not)) | del(.zone_map)' "$FILE")
    npx wrangler kv key put "config:settings" "$SETTINGS_JSON" "${TARGET_ARGS[@]}"
    echo "Seeded config:settings from $FILE"

    # If zone_map is defined in the config file, seed zone:map automatically
    if jq -e '.zone_map and (.zone_map | type == "object")' "$FILE" >/dev/null 2>&1; then
      ZONE_MAP_JSON=$(jq -c '.zone_map' "$FILE")
      npx wrangler kv key put "zone:map" "$ZONE_MAP_JSON" "${TARGET_ARGS[@]}"
      echo "Seeded zone:map from $FILE"
    fi
    ;;

  invite)
    USER="${1:-}"
    TTL_HOURS="${2:-24}"
    [[ -z "$USER" ]] && { echo "Error: username required"; usage; }
    USER=$(echo "$USER" | tr '[:upper:]' '[:lower:]')

    PIN=$(od -An -N4 -tu4 /dev/urandom | awk '{printf "%08d", $1 % 100000000}')
    TTL_SEC=$(( TTL_HOURS * 3600 ))
    EXP_MS=$(( ( $(date +%s) + TTL_SEC ) * 1000 ))

    PAYLOAD=$(jq -nc --arg pin "$PIN" '{pin: $pin}')
    META=$(jq -nc --argjson exp "$EXP_MS" '{exp: $exp}')

    npx wrangler kv key put "invite:${USER}" "$PAYLOAD" \
      --ttl="$TTL_SEC" \
      --metadata="$META" \
      "${TARGET_ARGS[@]}" > /dev/null

    echo "=========================================="
    echo " Invite Created for: ${USER}"
    echo " 8-Digit PIN:        ${PIN}"
    echo " Expires in:         ${TTL_HOURS} hours"
    echo "=========================================="
    ;;

  allow-exact|allow-suffix)
    USER="${1:-}"
    TARGET="${2:-}"
    [[ -z "$USER" || -z "$TARGET" ]] && { echo "Error: username and target required"; usage; }
    USER=$(echo "$USER" | tr '[:upper:]' '[:lower:]')
    TARGET=$(echo "$TARGET" | tr '[:upper:]' '[:lower:]')
    KEY="user:${USER}"

    RAW=$(npx wrangler kv key get "$KEY" "${TARGET_ARGS[@]}" 2>/dev/null || true)
    [[ -z "$RAW" ]] && { echo "Error: User '${USER}' not found in KV."; exit 1; }

    if [[ "$CMD" == "allow-exact" ]]; then
      UPDATED=$(echo "$RAW" | jq --arg h "$TARGET" '.allowed_exact = ((.allowed_exact + [$h]) | unique)')
    else
      UPDATED=$(echo "$RAW" | jq --arg s "$TARGET" '.allowed_suffixes = ((.allowed_suffixes + [$s]) | unique)')
    fi

    npx wrangler kv key put "$KEY" "$UPDATED" "${TARGET_ARGS[@]}" > /dev/null
    echo "$UPDATED" | jq '{id, allowed_exact, allowed_suffixes}'
    ;;

  revoke-host)
    USER="${1:-}"
    TARGET="${2:-}"
    [[ -z "$USER" || -z "$TARGET" ]] && { echo "Error: username and target required"; usage; }
    USER=$(echo "$USER" | tr '[:upper:]' '[:lower:]')
    TARGET=$(echo "$TARGET" | tr '[:upper:]' '[:lower:]')
    KEY="user:${USER}"

    RAW=$(npx wrangler kv key get "$KEY" "${TARGET_ARGS[@]}" 2>/dev/null || true)
    [[ -z "$RAW" ]] && { echo "Error: User '${USER}' not found."; exit 1; }

    UPDATED=$(echo "$RAW" | jq --arg t "$TARGET" '.allowed_exact -= [$t] | .allowed_suffixes -= [$t]')
    npx wrangler kv key put "$KEY" "$UPDATED" "${TARGET_ARGS[@]}" > /dev/null
    echo "$UPDATED" | jq '{id, allowed_exact, allowed_suffixes}'
    ;;

  show-user)
    USER="${1:-}"
    [[ -z "$USER" ]] && { echo "Error: username required"; usage; }
    npx wrangler kv key get "user:${USER}" "${TARGET_ARGS[@]}" | jq .
    ;;

  list-users)
    npx wrangler kv key list --prefix="user:" "${TARGET_ARGS[@]}" | jq -r '.[].name'
    ;;

  list-invites)
    npx wrangler kv key list --prefix="invite:" "${TARGET_ARGS[@]}" | jq .
    ;;

  audit)
    LIMIT="${1:-10}"
    KEYS=$(npx wrangler kv key list --prefix="audit:" "${TARGET_ARGS[@]}" | jq -r "sort_by(.name) | reverse | .[:${LIMIT}][].name")
    for k in $KEYS; do
      npx wrangler kv key get "$k" "${TARGET_ARGS[@]}" | jq -c .
    done
    ;;

  *)
    usage
    ;;
esac
</file>

<file path="src/index.ts">
export * from "./types";
export * from "./cf-dns";
export * from "./security";
export * from "./onboard";

import { Env, ServiceConfig } from "./types";
import { ONBOARD_HTML } from "./onboard-html";
import { hasActiveInvite, handleOnboardSubmit } from "./onboard";
import { extractCredentials, authenticateUserByKey } from "./security";
import { isHostAllowed, isValidPublicIp, reconcileDualStackRecords } from "./cf-dns";

function textResponse(body: string, status: number): Response {
  return new Response(body, {
    status,
    headers: { "Content-Type": "text/plain; charset=utf-8", "Cache-Control": "no-store" },
  });
}

function isOnboardRequest(url: URL, env: Env): boolean {
  const host = url.hostname.toLowerCase();
  if (env.ONBOARD_HOST && host === env.ONBOARD_HOST.toLowerCase()) {
    return true;
  }
  const prefix = (env.ONBOARD_PREFIX || "onboard-ddns.").toLowerCase();
  return host.startsWith(prefix);
}

async function resolveZoneAndConfig(
  hostname: string,
  env: Env
): Promise<{ zoneId: string | null; serviceConfig: ServiceConfig | null }> {
  const [zoneMap, serviceConfig] = await Promise.all([
    env.KV.get<Record<string, string>>("zone:map", "json"),
    env.KV.get<ServiceConfig>("config:settings", "json"),
  ]);

  const combinedDomains: Record<string, string> = {
    ...(serviceConfig?.ALLOW_LIST_DOMAINS || {}),
    ...(zoneMap || {}),
  };

  for (const [domain, id] of Object.entries(combinedDomains)) {
    const cleanDomain = domain.toLowerCase().replace(/^\./, "");
    if (hostname === cleanDomain || hostname.endsWith(`.${cleanDomain}`)) {
      return { zoneId: id, serviceConfig };
    }
  }

  return { zoneId: env.CF_ZONE_ID || null, serviceConfig };
}

function parseDualStackIps(
  request: Request,
  url: URL
): { ipv4: string | null; ipv6: string | null; isAutoDetected: boolean; hasInvalidIp: boolean } {
  const paramIp = url.searchParams.get("ip");
  const paramIpv6 = url.searchParams.get("ipv6");
  const paramMyIp = url.searchParams.get("myip");

  let ipv4: string | null = null;
  let ipv6: string | null = null;
  let hasInvalidIp = false;

  if (paramIp !== null || paramIpv6 !== null) {
    if (paramIp && paramIp.trim() !== "") {
      const candidate4 = paramIp.trim();
      if (isValidPublicIp(candidate4, "A")) ipv4 = candidate4;
      else hasInvalidIp = true;
    }
    if (paramIpv6 && paramIpv6.trim() !== "") {
      const candidate6 = paramIpv6.trim();
      if (isValidPublicIp(candidate6, "AAAA")) ipv6 = candidate6;
      else hasInvalidIp = true;
    }
    return { ipv4, ipv6, isAutoDetected: false, hasInvalidIp };
  }

  if (paramMyIp !== null && paramMyIp.trim() !== "") {
    const parts = paramMyIp.split(",").map((s) => s.trim()).filter(Boolean);
    for (const part of parts) {
      if (isValidPublicIp(part, "A")) ipv4 = part;
      else if (isValidPublicIp(part, "AAAA")) ipv6 = part;
      else hasInvalidIp = true;
    }
    return { ipv4, ipv6, isAutoDetected: false, hasInvalidIp };
  }

  const cfIp = (request.headers.get("CF-Connecting-IP") || "").trim();
  if (isValidPublicIp(cfIp, "A")) {
    ipv4 = cfIp;
  } else if (isValidPublicIp(cfIp, "AAAA")) {
    ipv6 = cfIp;
  } else {
    hasInvalidIp = true;
  }

  return { ipv4, ipv6, isAutoDetected: true, hasInvalidIp };
}

export async function ddnsHandler(
  request: Request,
  env: Env,
  ctx: ExecutionContext
): Promise<Response> {
  const url = new URL(request.url);

  // 1. Domain-Agnostic Onboarding Subdomain (matches onboard-ddns.*)
  if (isOnboardRequest(url, env)) {
    if (!(await hasActiveInvite(env.KV))) {
      return new Response(null, { status: 404 });
    }

    if (url.pathname === "/" && request.method === "GET") {
      return new Response(ONBOARD_HTML, {
        headers: { "Content-Type": "text/html; charset=utf-8", "Cache-Control": "no-store" },
      });
    }

    if ((url.pathname === "/" || url.pathname === "/onboard") && request.method === "POST") {
      return handleOnboardSubmit(request, env, ctx);
    }

    return new Response(null, { status: 404 });
  }

  // 2. DDNS Update Endpoint
  if (url.pathname === "/nic/update" || url.pathname === "/") {
    const creds = extractCredentials(request, url);
    if (!creds) {
      return new Response("badauth", {
        status: 401,
        headers: { "Content-Type": "text/plain", "WWW-Authenticate": 'Basic realm="DDNS"' },
      });
    }

    const user = await authenticateUserByKey(creds, env.KV);
    if (!user) return textResponse("badauth", 403);

    const rawHost = url.searchParams.get("hostname");
    if (!rawHost) return textResponse("notfqdn", 400);
    const hostname = rawHost.trim().toLowerCase().replace(/\.$/, "");

    const { zoneId, serviceConfig } = await resolveZoneAndConfig(hostname, env);
    if (!zoneId || !isHostAllowed(hostname, user, serviceConfig)) {
      return textResponse("nohost", 403);
    }

    const { ipv4, ipv6, isAutoDetected, hasInvalidIp } = parseDualStackIps(request, url);
    if (hasInvalidIp || (!ipv4 && !ipv6 && isAutoDetected)) {
      return textResponse("dnserr", 400);
    }

    try {
      const result = await reconcileDualStackRecords(
        zoneId,
        env.CF_API_TOKEN,
        hostname,
        ipv4,
        ipv6,
        isAutoDetected
      );
      return textResponse(result.summary, 200);
    } catch {
      return textResponse("911", 502);
    }
  }

  return textResponse("notfound", 404);
}

export default {
  fetch: ddnsHandler,
};
</file>

<file path="src/onboard.ts">
import { Env, InviteRecord, UserRule, AuditEntry } from "./types";
import {
  sha256Hex,
  generateAlphanumeric,
  generateHex,
  timingSafeEqualString,
  validatePasswordComplexity,
} from "./security";

const MAX_PIN_ATTEMPTS = 3;
const AUDIT_TTL_SECONDS = 90 * 86400;
const DEFAULT_INVITE_TTL_SECONDS = 86400;

function jsonResponse(data: unknown, status: number): Response {
  return new Response(JSON.stringify(data), {
    status,
    headers: { "Content-Type": "application/json", "Cache-Control": "no-store" },
  });
}

export async function hasActiveInvite(kv: KVNamespace): Promise<boolean> {
  try {
    const listResult = await kv.list({ prefix: "invite:", limit: 1 });
    return listResult.keys.length > 0;
  } catch {
    return false;
  }
}

export async function writeAuditLog(kv: KVNamespace, entry: AuditEntry): Promise<void> {
  try {
    const key = `audit:${entry.timestamp}:${generateHex(4)}`;
    await kv.put(key, JSON.stringify(entry), { expirationTtl: AUDIT_TTL_SECONDS });
  } catch {
    // Ignore telemetry write errors
  }
}

export async function handleOnboardSubmit(
  request: Request,
  env: Env,
  ctx: ExecutionContext
): Promise<Response> {
  const clientIp = request.headers.get("CF-Connecting-IP") || "unknown";
  const country = request.headers.get("CF-IPCountry") || "unknown";
  const userAgent = request.headers.get("User-Agent") || "unknown";

  const isBlocked = await env.KV.get(`blocked_ip:${clientIp}`);
  if (isBlocked !== null) {
    return jsonResponse({ error: "Access denied." }, 403);
  }

  let body: { username?: string; pin?: string; mode?: string; password?: string };
  try {
    body = await request.json();
  } catch {
    return jsonResponse({ error: "Invalid request payload." }, 400);
  }

  const username = (body.username || "").trim().toLowerCase();
  const pin = (body.pin || "").trim();
  const mode = body.mode === "password" ? "password" : "token";

  if (!/^[a-z0-9_-]{2,32}$/.test(username) || !/^\d{8}$/.test(pin)) {
    return jsonResponse({ error: "Invalid username or 8-digit PIN." }, 400);
  }

  const inviteKey = `invite:${username}`;
  const userKey = `user:${username}`;

  const [inviteWithMeta, existingUser] = await Promise.all([
    env.KV.getWithMetadata<InviteRecord, { exp?: number }>(inviteKey, "json"),
    env.KV.get<UserRule>(userKey, "json"),
  ]);

  const invite = inviteWithMeta.value;

  if (!invite) {
    ctx.waitUntil(
      writeAuditLog(env.KV, {
        timestamp: new Date().toISOString(),
        event: "unknown_or_expired_invite",
        username,
        ip: clientIp,
        country,
        user_agent: userAgent,
      })
    );
    return jsonResponse({ error: "Invalid or expired username/PIN." }, 403);
  }

  if (existingUser) {
    return jsonResponse({ error: "User already exists. Contact admin to reset." }, 409);
  }

  if (!timingSafeEqualString(invite.pin, pin)) {
    const attempts = (invite.attempts || 0) + 1;

    if (attempts >= MAX_PIN_ATTEMPTS) {
      await env.KV.delete(inviteKey);
      ctx.waitUntil(
        writeAuditLog(env.KV, {
          timestamp: new Date().toISOString(),
          event: "invite_burned_max_attempts",
          username,
          ip: clientIp,
          country,
          user_agent: userAgent,
        })
      );
      return jsonResponse(
        { error: "Too many failed attempts. This invite has been locked and deleted." },
        403
      );
    }

    const remainingTtl = inviteWithMeta.metadata?.exp
      ? Math.max(60, Math.floor((inviteWithMeta.metadata.exp - Date.now()) / 1000))
      : DEFAULT_INVITE_TTL_SECONDS;

    invite.attempts = attempts;
    await env.KV.put(inviteKey, JSON.stringify(invite), {
      expirationTtl: remainingTtl,
      metadata: inviteWithMeta.metadata,
    });

    const remaining = MAX_PIN_ATTEMPTS - attempts;
    return jsonResponse(
      { error: `Invalid username or PIN. ${remaining} attempt(s) remaining.` },
      403
    );
  }

  let finalSecret = "";
  if (mode === "token") {
    finalSecret = generateAlphanumeric(16);
  } else {
    const pw = body.password || "";
    const pwError = validatePasswordComplexity(pw);
    if (pwError) return jsonResponse({ error: pwError }, 400);
    finalSecret = pw;
  }

  const salt = generateHex(8);
  const secret_hash = await sha256Hex(`${salt}${finalSecret}`);

  const newUser: UserRule = {
    id: username,
    salt,
    secret_hash,
    allowed_exact: [],
    allowed_suffixes: [],
  };

  await Promise.all([
    env.KV.put(userKey, JSON.stringify(newUser, null, 2)),
    env.KV.delete(inviteKey),
  ]);

  ctx.waitUntil(
    writeAuditLog(env.KV, {
      timestamp: new Date().toISOString(),
      event: "onboard_success",
      username,
      ip: clientIp,
      country,
      user_agent: userAgent,
    })
  );

  return jsonResponse({ username, secret: finalSecret, mode }, 200);
}
