<file path=".github/workflows/ci.yml">
name: Online CI & Cloud Edge Smoke Tests

on:
  push:
    branches: ["main"]
  pull_request:
    branches: ["main"]
  workflow_dispatch:

permissions:
  contents: read

jobs:
  unit-and-build:
    name: Typecheck, Workerd Suite & Build
    runs-on: ubuntu-latest
    steps:
      - name: Checkout repository
        uses: actions/checkout@v6

      - name: Setup Node.js
        uses: actions/setup-node@v6
        with:
          node-version: "24"
          cache: "npm"

      - name: Install dependencies
        run: npm ci

      - name: Run TypeScript typecheck
        run: npm run typecheck

      - name: Run workerd integration tests
        run: npm test

      - name: Verify package build output
        run: npm run build

  edge-smoke-test:
    name: Deploy Edge Preview & Live Curl Smoke Test
    needs: unit-and-build
    # Only run live Cloudflare API steps when secrets are available (push to main or internal PRs)
    if: github.event_name == 'push' || github.event.pull_request.head.repo.full_name == github.repository
    runs-on: ubuntu-latest
    env:
      CLOUDFLARE_API_TOKEN: ${{ secrets.CF_API_TOKEN_DEPLOY }}
      CLOUDFLARE_ACCOUNT_ID: ${{ secrets.CF_ACCOUNT_ID }}
    steps:
      - name: Checkout repository
        uses: actions/checkout@v6

      - name: Setup Node.js
        uses: actions/setup-node@v6
        with:
          node-version: "24"
          cache: "npm"

      - name: Install dependencies
        run: npm ci

      - name: Build deployment Wrangler config & config.json from DDNS_ZONE_MAP
        env:
          DDNS_ZONE_MAP: ${{ vars.DDNS_ZONE_MAP }}
        run: |
          if [ -n "$DDNS_ZONE_MAP" ]; then
            jq --argjson zmap "$DDNS_ZONE_MAP" '.zone_map = $zmap' default-config.json > config.json
            jq --argjson zmap "$DDNS_ZONE_MAP" '
              ($zmap | keys_unsorted) as $d |
              . + {
                routes: (
                  ($d | map({ pattern: ("ddns." + .), custom_domain: true })) +
                  ($d | map({ pattern: ((.vars.ONBOARD_PREFIX // "onboard-ddns.") + .), custom_domain: true }))
                )
              }
            ' wrangler.jsonc > wrangler.deploy.jsonc
          else
            cp default-config.json config.json
            cp wrangler.jsonc wrangler.deploy.jsonc
          fi

      - name: Ensure base Worker exists, auto-provision KV & sync runtime secret
        run: |
          npx wrangler deploy --config wrangler.deploy.jsonc --keep-vars
          if [ -n "${{ secrets.CF_API_TOKEN }}" ]; then
            printf "%s" "${{ secrets.CF_API_TOKEN }}" | npx wrangler secret put CF_API_TOKEN --config wrangler.deploy.jsonc
          fi

      - name: Upload Worker Preview Version & Extract Preview URL
        id: preview
        run: |
          OUTPUT=$(npx wrangler versions upload --preview-alias "ci-${GITHUB_RUN_ID}")
          echo "$OUTPUT"
          PREVIEW_URL=$(echo "$OUTPUT" | grep -oE 'https://[a-zA-Z0-9.-]+\.workers\.dev' | tail -n 1)
          if [ -z "$PREVIEW_URL" ]; then
            echo "::error::Failed to extract Preview URL from Wrangler output"
            exit 1
          fi
          echo "url=$PREVIEW_URL" >> "$GITHUB_OUTPUT"
          echo "Uploaded live preview to: $PREVIEW_URL"

      - name: Discover Auto-Provisioned KV Namespace ID
        id: kv
        run: |
          KV_ID=$(npx wrangler kv namespace list | jq -r '.[] | select(.title == "cloudflare-ddns-service-kv" or (.title | ascii_downcase | endswith("-kv"))) | .id' | head -n 1)
          if [ -z "$KV_ID" ]; then
            echo "::error::Could not locate auto-provisioned KV namespace"
            exit 1
          fi
          echo "id=$KV_ID" >> "$GITHUB_OUTPUT"

      - name: Seed config into KV
        env:
          DDNS_ZONE_MAP: ${{ vars.DDNS_ZONE_MAP }}
        run: |
          if [ ! -f config.json ]; then
            if [ -n "$DDNS_ZONE_MAP" ]; then
              jq --argjson zmap "$DDNS_ZONE_MAP" '
                .zone_map = $zmap |
                .allowed_domains = ($zmap | keys)
              ' default-config.json > config.json
            else
              cp default-config.json config.json
            fi
          fi
          chmod +x scripts/ddns-admin.sh
          ./scripts/ddns-admin.sh seed-config config.json

      - name: Run Live Edge Curl Assertions (Auth, Protocol & Onboarding)
        env:
          PREVIEW_URL: ${{ steps.preview.outputs.url }}
          KV_ID: ${{ steps.kv.outputs.id }}
        run: |
          DOMAIN=$(jq -r '.zone_map | keys_unsorted[0] // "example.com"' config.json)
          DOMAIN="${DOMAIN:-example.com}"
          set -euo pipefail
          TEST_USER="ci-smoke-${GITHUB_RUN_ID}"
          INVITE_KEY="invite:${TEST_USER}"
          USER_KEY="user:${TEST_USER}"

          cleanup() {
            echo "Cleaning up ephemeral KV test keys..."
            npx wrangler kv key delete "$INVITE_KEY" --namespace-id="$KV_ID" --remote || true
            npx wrangler kv key delete "$USER_KEY" --namespace-id="$KV_ID" --remote || true
          }
          trap cleanup EXIT

          echo "--- Test 1: Unauthenticated request returns 401 badauth ---"
          HTTP_401=$(curl -s -o /tmp/res1.txt -w "%{http_code}" "${PREVIEW_URL}/nic/update?hostname=ci.${DOMAIN}")
          BODY_401=$(cat /tmp/res1.txt)
          [ "$HTTP_401" = "401" ] && [ "$BODY_401" = "badauth" ] || {
            echo "::error::Expected 401 badauth, got ${HTTP_401} (${BODY_401})"
            exit 1
          }

          echo "--- Test 2: Invalid credentials return 403 badauth (Constant-Time Path) ---"
          HTTP_403=$(curl -s -o /tmp/res2.txt -w "%{http_code}" -u "${TEST_USER}:wrongpass" "${PREVIEW_URL}/nic/update?hostname=ci.${DOMAIN}")
          BODY_403=$(cat /tmp/res2.txt)
          [ "$HTTP_403" = "403" ] && [ "$BODY_403" = "badauth" ] || {
            echo "::error::Expected 403 badauth, got ${HTTP_403} (${BODY_403})"
            exit 1
          }

          echo "--- Test 3: Seed temporary user and verify unauthorized host returns 403 nohost ---"
          HASH=$(printf "cisalt12citoken123456789" | sha256sum | awk '{print $1}')
          USER_JSON=$(jq -nc --arg id "$TEST_USER" --arg h "$HASH" '{
            id: $id,
            salt: "cisalt12",
            secret_hash: $h,
            allowed_exact: ["ci-allowed.${DOMAIN}"],
            allowed_suffixes: []
          }')
          npx wrangler kv key put "$USER_KEY" "$USER_JSON" --namespace-id="${{ steps.kv.outputs.id }}" --remote

          sleep 2
          HTTP_NOHOST=$(curl -s -o /tmp/res3.txt -w "%{http_code}" -u "${TEST_USER}:citoken123456789" "${PREVIEW_URL}/nic/update?hostname=ci-forbidden.${DOMAIN}")
          BODY_NOHOST=$(cat /tmp/res3.txt)
          [ "$HTTP_NOHOST" = "403" ] && [ "$BODY_NOHOST" = "nohost" ] || {
            echo "::error::Expected 403 nohost, got ${HTTP_NOHOST} (${BODY_NOHOST})"
            exit 1
          }

          echo "--- Test 4: Verify RFC1918 / Bogon IP rejection returns 400 dnserr ---"
          HTTP_DNSERR=$(curl -s -o /tmp/res4.txt -w "%{http_code}" -u "${TEST_USER}:citoken123456789" "${PREVIEW_URL}/nic/update?hostname=ci-allowed.${DOMAIN}&ip=192.168.1.50")
          BODY_DNSERR=$(cat /tmp/res4.txt)
          [ "$HTTP_DNSERR" = "400" ] && [ "$BODY_DNSERR" = "dnserr" ] || {
            echo "::error::Expected 400 dnserr for RFC1918 IP, got ${HTTP_DNSERR} (${BODY_DNSERR})"
            exit 1
          }

          echo "--- Test 5: Verify Onboarding Portal stays dark (404), accepts valid PIN, and goes dark again ---"
          HTTP_DARK1=$(curl -s -o /dev/null -w "%{http_code}" -H "Host: onboard-ddns.${DOMAIN}" "${PREVIEW_URL}/")
          [ "$HTTP_DARK1" = "404" ] || {
            echo "::error::Expected 404 dark onboarding portal when no invite exists, got ${HTTP_DARK1}"
            exit 1
          }

          npx wrangler kv key put "$INVITE_KEY" '{"pin":"99887766"}' --namespace-id="${{ steps.kv.outputs.id }}" --ttl=300 --remote
          sleep 2

          ONBOARD_RES=$(curl -s -w "\n%{http_code}" -X POST "${PREVIEW_URL}/onboard" \
            -H "Host: onboard-ddns.${DOMAIN}" \
            -H "Content-Type: application/json" \
            -d "{\"username\":\"${TEST_USER}\",\"pin\":\"99887766\",\"mode\":\"token\"}")
          HTTP_ONBOARD=$(echo "$ONBOARD_RES" | tail -n1)
          ONBOARD_BODY=$(echo "$ONBOARD_RES" | sed '$d')
          [ "$HTTP_ONBOARD" = "200" ] && echo "$ONBOARD_BODY" | jq -e '.secret | length == 16' >/dev/null || {
            echo "::error::Expected 200 and 16-char secret from /onboard, got ${HTTP_ONBOARD} (${ONBOARD_BODY})"
            exit 1
          }

          HTTP_DARK2=$(curl -s -o /dev/null -w "%{http_code}" -H "Host: onboard-ddns.${DOMAIN}" "${PREVIEW_URL}/")
          [ "$HTTP_DARK2" = "404" ] || {
            echo "::error::Expected onboarding portal to return to 404 after invite burned, got ${HTTP_DARK2}"
            exit 1
          }

          echo "All live Cloudflare edge smoke assertions passed!"
</file>

<file path="README.md">
# cloudflare-ddns-service

A zero-dependency, multi-tenant, dual-stack (`A` / `AAAA`) DynDNS2 Cloudflare Worker package with self-service KV PIN onboarding and automatic stale DNS record pruning.

Designed for routers (**TP-Link Omada**, **MikroTik RouterOS**, **Ubiquiti UniFi**, **OPNsense/pfSense**, and standard `ddclient`/`inadyn` daemons) that only have built in support for DynDNS like DDNS to update IPv4 and IPv6 records across multiple Cloudflare zones without using Cloudflare API tokens.

---

## Key Features

- **Dual-Stack State Reconciliation & Pruning:** Concurrently creates, updates, or deletes `A` and `AAAA` records. When a router explicitly reports an empty IPv6 or IPv4 parameter (e.g., ISP prefix drop), the stale record is automatically pruned from Cloudflare DNS.
- **Safe Passive Auto-Detection:** If a client calls the endpoint without IP query parameters (`?hostname=node.example.com`), the Worker detects the connecting IP via `CF-Connecting-IP` and updates the corresponding `A` or `AAAA` record *without* pruning the opposite address family.
- **$O(1)$ Keyed Authentication & Constant-Time Crypto:** Stores per-user salted SHA-256 credentials under isolated `user:<username>` KV keys. Uses `crypto.subtle.timingSafeEqual` and dummy hash burning to prevent timing side-channels and username enumeration.
- **Dark Self-Service Onboarding Portal:** Exposes an optional onboarding web UI on a dedicated hostname (`ONBOARD_HOST`). The portal returns an empty `404` unless an active `invite:<username>` key exists in KV.
- **Multi-Zone Routing:** Maps multiple root domains to their respective Cloudflare Zone IDs via a single `zone:map` KV entry, falling back to `env.CF_ZONE_ID`.
- **Non-Blocking Telemetry:** Writes auto-expiring (`audit:<timestamp>:<id>`) security events via `ctx.waitUntil()` with zero impact on response latency.

---

## Installation & GitOps Wrapper Usage

Install the package in your Cloudflare Worker project or GitOps monorepo:

```bash
npm install cloudflare-ddns-service
